# Copy to .env for `docker compose up`. Never commit the real .env.

# --- Database ---
POSTGRES_DB=queueup
DB_USER=queueup
DB_PASSWORD=change-me-local-only
# JDBC URL or postgres://user:pass@host:5432/db (Render style); both are accepted.
DATABASE_URL=jdbc:postgresql://postgres:5432/queueup

# --- Security ---
# Base64, at least 256 bits. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48
# Comma-separated list of allowed browser origins.
FRONTEND_ORIGIN=http://localhost:5173

# --- Mail (Mailpit locally: UI at http://localhost:8025) ---
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=QueueUp <no-reply@queueup.local>

# --- PayMongo (test mode keys from https://dashboard.paymongo.com/developers) ---
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# --- Demo data ---
SEED_DEMO=true

# --- Frontend build ---
# Where the browser reaches the API. Empty = same origin (nginx proxies /api and /ws in docker compose).
VITE_API_URL=
