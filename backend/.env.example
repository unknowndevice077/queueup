# Backend environment variables (Spring Boot). For `./mvnw spring-boot:run` export these or use your IDE.
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/queueup
DB_USER=queueup
DB_PASSWORD=change-me-local-only
# Base64, at least 256 bits: openssl rand -base64 48 (the dev profile has a built-in fallback)
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=QueueUp <no-reply@queueup.local>
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
SEED_DEMO=true
PORT=8080
